{
  "name": "esource",
  "version": "1.0.0",
  "description": "Git GUI desktop client - SourceTree alternative",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev:electron:no-vite": "cross-env NODE_ENV=development electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "git",
    "gui",
    "electron",
    "git-client"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.esource.app",
    "productName": "eSource",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist-release"
    },
    "linux": {
      "target": ["deb"],
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "eSource Team",
      "description": "Git GUI desktop client - SourceTree alternative"
    },
    "deb": {
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.26.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  }
}
